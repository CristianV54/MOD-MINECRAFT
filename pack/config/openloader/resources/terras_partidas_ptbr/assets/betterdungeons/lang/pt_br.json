  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.@Tooltip": "Configurações Gerais",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableHeads": "Ativar Crânios e Cabeças",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableHeads.@Tooltip[0]": "Define se as masmorras podem colocar crânios de esqueleto e outras cabeças de criaturas.",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableHeads.@Tooltip[1]": "Esta opção pode ser útil para alguns criadores de modpacks.",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableHeads.@Tooltip[2]": "Padrão: true",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableNetherBlocks": "Ativar Blocos do Nether nas Masmorras",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableNetherBlocks.@Tooltip[0]": "Algumas masmorras podem gerar raramente blocos do Nether, como areia das almas, fogueiras das almas e lampiões das almas.",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableNetherBlocks.@Tooltip[1]": "Os blocos serão apenas decorativos - nada que quebre a progressão, como Detritos Ancestrais.",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableNetherBlocks.@Tooltip[2]": "Defina como false para impedir que blocos do Nether surjam nas masmorras.",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableNetherBlocks.@Tooltip[3]": "Esta opção pode ser útil para alguns criadores de modpacks.",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.enableNetherBlocks.@Tooltip[4]": "Padrão: true",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.removeVanillaDungeons": "Remover Masmorras Vanilla",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[0]": "Define se as masmorras vanilla devem ser impedidas de surgir no mundo.",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[1]": "Recomenda-se desativá-las, já que as Masmorras Pequenas têm um design bem parecido.",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[2]": "Padrão: true",
  "text.autoconfig.betterdungeons-fabric-1_20.option.betterDungeons.smallDungeon": "Masmorras Pequenas",
