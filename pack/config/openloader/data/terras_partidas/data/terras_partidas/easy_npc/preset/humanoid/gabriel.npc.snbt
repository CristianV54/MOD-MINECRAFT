              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                },
                {
                  Cmd:"/ftbquests open_book",
                  ExecAsUser:1b,
                  PermLevel:0,
                  Type:"COMMAND"
                }
              ],
              Label:"livro",
              Name:"Abrir o livro de missões"
            },
            {
