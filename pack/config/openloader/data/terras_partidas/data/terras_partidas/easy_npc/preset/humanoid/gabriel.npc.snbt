                  Cmd:"dragoes",
                  Type:"OPEN_NAMED_DIALOG"
                }
              ],
              Label:"dragoes_btn",
              Name:"Como cuidar de um dragão"
            },
            {
              Actions:[
                {
                  Cmd:"quem",
                  Type:"OPEN_NAMED_DIALOG"
                }
              ],
              Label:"quem_btn",
              Name:"Quem é você?"
            },
            {
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                },
                {
                  Msg:{
                    T:4b,
                    Texts:[
                      "Mantenha a cabeça erguida, @initiator."
                    ]
                  },
                  Type:"MESSAGE"
                }
              ],
              Label:"tchau",
              Name:"Até mais, Gabriel"
            }
          ],
          Label:"voou",
          Name:"Gabriel",
          Priority:3,
          Texts:[
            {
              Text:"Eu vi você no céu, @initiator.\\n\\nFaz muito tempo que um dragão da Ordem não voava. Os antigos guardiões ficariam orgulhosos, e eu também estou.\\n\\nAgora vá. O Nether espera, e você não está mais sozinho."
            }
          ],
          Conditions:[
            {
              Name:"terras_partidas_voou",
              Type:"PLAYER_TAG"
            }
          ]
        },
        {
          Buttons:[
            {
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                },
                {
                  Cmd:"/ftbquests open_book",
                  ExecAsUser:1b,
                  PermLevel:0,
                  Type:"COMMAND"
                }
              ],
              Label:"livro",
              Name:"Abrir o livro de missões"
            },
            {
              Actions:[
                {
                  Cmd:"dragoes",
                  Type:"OPEN_NAMED_DIALOG"
                }
              ],
              Label:"dragoes_btn",
              Name:"Como cuidar de um dragão"
            },
            {
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                },
                {
                  Msg:{
                    T:4b,
                    Texts:[
                      "Mantenha a cabeça erguida, @initiator."
                    ]
                  },
                  Type:"MESSAGE"
                }
              ],
              Label:"tchau",
              Name:"Até mais, Gabriel"
            }
          ],
          Label:"pronto",
          Name:"Estou pronto",
          Priority:-1,
          Texts:[
            {
              Text:"Foi o que eu esperava ouvir.\\n\\nAbra o livro de missões, no capítulo do Ato 2, e escolha um dos quatro ovos: fogo, gelo, água ou floresta. Escolha com cuidado. Depois que um ovo for escolhido, os outros serão selados para sempre.\\n\\nQuando ele chocar, cuide dele como cuidaria de um irmão."
            }
          ]
        },
        {
          Buttons:[
            {
              Actions:[
                {
                  Type:"OPEN_DEFAULT_DIALOG"
                }
              ],
              Label:"voltar",
              Name:"Voltar"
            }
          ],
          Label:"dragoes",
          Name:"Como cuidar de um dragão",
          Priority:-1,
          Texts:[
            {
              Text:"Coloque o ovo em cima de um bloco firme e clique nele com o botão direito para ele começar a chocar.\\n\\nO lugar importa: até chocar, mantenha o ovo perto dos blocos do tipo dele (magma, gelo, prismarinho ou musgo) para ele continuar do tipo escolhido.\\n\\nAlimente o filhote com carne até ele crescer. Depois coloque a sela e monte. Pular sobe, agachar desce."
            }
          ]
        },
        {
          Buttons:[
            {
              Actions:[
                {
                  Type:"OPEN_DEFAULT_DIALOG"
                }
              ],
              Label:"voltar",
              Name:"Voltar"
            }
          ],
          Label:"quem",
          Name:"Quem é você?",
          Priority:-1,
          Texts:[
            {
              Text:"Meu pai serviu à Ordem, e o pai dele antes. Quando o Selo foi criado, minha família jurou guardar os ovos dos dragões dos guardiões.\\n\\nEu nunca fui o mais forte da Ordem. Mas nunca saí do meu posto, nem quando os monstros cercaram a torre. Coragem é isso: ficar quando dá vontade de correr."
            }
          ]
        }
      ],
      Type:"STANDARD"
    },
