          ],
          Label:"classe_cacador",
          Name:"Caçador",
          Priority:-1,
          Texts:[
            {
              Text:"CAÇADOR\\n\\nPrós: Ataca de longe com arco, é seguro contra chefes grandes e se move rápido.\\n\\nContras: Precisa de flechas e sofre quando é cercado.\\n\\nA escolha é para sempre. Cada classe tem sua própria árvore de habilidades (tecla K)."
            }
          ]
        },
        {
          Buttons:[
            {
              Actions:[
