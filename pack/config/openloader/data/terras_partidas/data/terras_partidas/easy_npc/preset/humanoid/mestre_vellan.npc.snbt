          Name:"Assassino",
          Priority:-1,
          Texts:[
            {
              Text:"ASSASSINO\\n\\nPrós: Rápido, com muitos acertos críticos e esquivas. Duas adagas e o passo rápido.\\n\\nContras: Pouca vida: cada erro custa caro.\\n\\nA escolha é para sempre. Cada classe tem sua própria árvore de habilidades (tecla K)."
            }
          ]
