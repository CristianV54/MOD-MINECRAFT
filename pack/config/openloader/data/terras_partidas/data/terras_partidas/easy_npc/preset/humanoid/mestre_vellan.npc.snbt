          ],
          Label:"ato4",
          Name:"Além do Céu",
          Priority:5,
          Texts:[
            {
              Text:"Onze fragmentos. E agora a verdade: os guardiões do Selo nunca morreram, @initiator.\\n\\nEles vivem no Everbright e no Everdawn, acima das nuvens, mas enlouqueceram. Tijolo turquesa abre o caminho para o Everbright. Tijolo lunar, para o Everdawn."
            }
          ],
          Conditions:[
            {
              Name:"terras_partidas_ato3",
              Type:"PLAYER_TAG"
            }
          ]
        },
