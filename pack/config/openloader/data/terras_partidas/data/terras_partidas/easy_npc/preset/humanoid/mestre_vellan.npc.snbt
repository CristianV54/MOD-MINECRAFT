                  Type:"MESSAGE"
                }
              ],
              Label:"tchau",
              Name:"Até mais, Mestre"
            }
          ],
          Label:"ato2",
          Name:"Terras Selvagens",
          Priority:2,
          Texts:[
            {
              Text:"Três fragmentos, @initiator. Melhor do que qualquer caçador em anos.\\n\\nOs próximos estão longe: no gelo eterno, nas savanas queimadas, no mar congelado e com a jogadora de almas, Dame Fortuna. Use os mapas que eu te der e o planador para atravessar o mundo."
            }
          ],
          Conditions:[
            {
              Name:"terras_partidas_ato1",
              Type:"PLAYER_TAG"
            }
          ]
        },
