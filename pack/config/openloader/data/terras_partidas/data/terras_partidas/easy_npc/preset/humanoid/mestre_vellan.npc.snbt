          Label:"classe_mago",
          Name:"Mago",
          Priority:-1,
          Texts:[
            {
              Text:"MAGO\\n\\nPrós: Dano de longe com feitiços, inclusive cura. Livro de feitiços e Mesa de Inscrição desde o começo.\\n\\nContras: Frágil no começo e depende de mana e de pergaminhos.\\n\\nA escolha é para sempre. Cada classe tem sua própria árvore de habilidades (tecla K)."
            }
          ]
        },
