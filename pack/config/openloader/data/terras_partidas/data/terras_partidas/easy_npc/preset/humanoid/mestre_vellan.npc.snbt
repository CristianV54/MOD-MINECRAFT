          ],
          Label:"inicio",
          Name:"Bem-vindo",
          Priority:1,
          Texts:[
            {
              Text:"Bem-vindo à Ordem dos Caçadores, @initiator.\\n\\nO Selo se partiu e os fragmentos corromperam criaturas poderosas. Os três primeiros estão perto daqui: algo enorme nos pântanos, um espírito que toca um sino, e um cavaleiro de metal numa câmara no subsolo.\\n\\nComece escolhendo o seu caminho no livro de missões."
            }
          ]
        },
        {
          Buttons:[
            {
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                },
                {
                  Cmd:"/ftbquests open_book",
                  ExecAsUser:1b,
                  PermLevel:0,
                  Type:"COMMAND"
                }
              ],
              Label:"livro",
              Name:"Abrir o livro de missões"
            },
            {
              Actions:[
                {
                  Cmd:"historia",
                  Type:"OPEN_NAMED_DIALOG"
                }
              ],
              Label:"historia_btn",
              Name:"Conte a história do Selo"
            },
            {
              Actions:[
                {
