                }
              ],
              Label:"escolher_guerreiro",
              Name:"Escolher Guerreiro"
            },
            {
              Actions:[
                {
                  Cmd:"escolha",
                  Type:"OPEN_NAMED_DIALOG"
                }
              ],
              Label:"voltar_guerreiro",
              Name:"Ver outra classe"
            }
          ],
          Label:"classe_guerreiro",
          Name:"Guerreiro",
          Priority:-1,
          Texts:[
            {
              Text:"GUERREIRO\\n\\nPrós: Equilibrado: bom dano, boa vida e armadura. A classe mais fácil para começar.\\n\\nContras: Não se destaca em nada. Luta sempre de perto.\\n\\nA escolha é para sempre. Cada classe tem sua própria árvore de habilidades (tecla K)."
            }
          ]
        },
