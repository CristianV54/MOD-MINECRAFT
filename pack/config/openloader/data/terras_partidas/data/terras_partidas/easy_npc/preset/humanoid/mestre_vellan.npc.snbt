          ],
          Label:"escolhida",
          Name:"Caminho escolhido",
          Priority:-1,
          Texts:[
            {
              Text:"Ótima escolha, @initiator.\\n\\nAbra o livro de missões e pegue as recompensas das primeiras missões: lá está o seu kit de classe. Depois, siga as missões. Eu vou estar por aqui sempre que você quiser conversar."
            }
          ]
        },
        {
          Buttons:[
            {
              Actions:[
                {
                  Type:"OPEN_DEFAULT_DIALOG"
                }
              ],
              Label:"voltar",
              Name:"Voltar"
            }
          ],
          Label:"dicas",
          Name:"Dicas de combate",
          Priority:-1,
          Texts:[
            {
              Text:"Aperte R para entrar no modo de combate.\\n\\nEsquivar e defender gasta a barra de fôlego. Não ataque sem parar: espere o inimigo errar e contra-ataque.\\n\\nCada chefe derrotado te dá um livro de habilidade. Use o livro (clique direito) para aprender um movimento novo."
            }
          ]
        }
