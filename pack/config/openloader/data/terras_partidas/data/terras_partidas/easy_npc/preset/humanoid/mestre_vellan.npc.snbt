          ],
          Label:"ato5",
          Name:"O Fim do Selo",
          Priority:6,
          Texts:[
            {
              Text:"Quinze fragmentos, @initiator. O Selo só pode ser refeito onde foi quebrado: no End.\\n\\nEncontre a fortaleza escondida, derrote o Dragão e os guardiões do vazio. E não use a Estrela do Nether do Wither num sinalizador: você vai precisar dela para despertar o que guarda o último fragmento."
            }
          ],
          Conditions:[
            {
              Name:"terras_partidas_ato4",
              Type:"PLAYER_TAG"
            }
          ]
        },
