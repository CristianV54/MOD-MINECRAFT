              Label:"tchau",
              Name:"Até mais, Mestre"
            }
          ],
          Label:"inicio",
          Name:"Bem-vindo",
          Priority:2,
          Texts:[
            {
              Text:"Bem-vindo à Ordem dos Caçadores, @initiator.\\n\\nO Selo se partiu e os fragmentos corromperam criaturas poderosas. Os três primeiros estão nesta região: algo enorme nos pântanos, um espírito que toca um sino, e um cavaleiro de metal numa câmara no subsolo.\\n\\nSeu kit já está no inventário, e suas primeiras missões estão no livro de missões. Quando quiser conversar, é só voltar aqui."
            }
          ],
          Conditions:[
            {
              Name:"terras_partidas_classe",
              Type:"PLAYER_TAG"
            }
          ]
        },
        {
          Buttons:[
            {
              Actions:[
                {
                  Type:"CLOSE_DIALOG"
                },
                {
                  Cmd:"/ftbquests open_book",
                  ExecAsUser:1b,
                  PermLevel:0,
                  Type:"COMMAND"
                }
              ],
              Label:"livro",
              Name:"Abrir o livro de missões"
            },
            {
              Actions:[
                {
                  Cmd:"historia",
                  Type:"OPEN_NAMED_DIALOG"
                }
              ],
              Label:"historia_btn",
              Name:"Conte a história do Selo"
            },
            {
              Actions:[
                {
                  Cmd:"dicas",
                  Type:"OPEN_NAMED_DIALOG"
                }
              ],
              Label:"dicas_btn",
