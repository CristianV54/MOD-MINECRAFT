	quests: [
		{
			id: "3BB64CCD28B4E329"
			title: "O Chamado"
			x: 0.0d
			y: 1.5d
			subtitle: "Uma carta com o selo da Ordem"
			icon: "minecraft:writable_book"
			shape: "gear"
			size: 2.0d
			description: ["&o\"Caçador,", "", "&oHá trezentos anos, sete guardiões prenderam um mal antigo dentro de um cristal: o &dSelo&r&o.", "&oNa última lua cheia, o Selo se partiu. Os fragmentos caíram pelo mundo e cada um corrompeu uma criatura poderosa.", "", "&oSe juntarmos os fragmentos antes que o mal desperte, ainda há esperança.", "&oA Ordem dos Caçadores precisa de você.\"", "", "— &6Mestre Vellan&r, Mestre da Ordem", "{@pagebreak}", "&eComo usar este livro:&r", "• Cada missão mostra o objetivo e a recompensa.", "• Clique em uma missão para ver os detalhes e pegar a recompensa.", "• Missões novas aparecem conforme você avança.", "", "&eCombate:&r este mundo usa o &cEpic Fight&r. Aperte &eR&r para alternar entre o modo normal e o modo de combate.", "As outras teclas ficam em &eOpções > Controles&r, na seção do Epic Fight.", "", "&eOutras teclas:&r &eK&r árvores de habilidades, &eJ&r movimentos do Epic Fight, &eV&r lança o feitiço escolhido, &eZ&r roda de feitiços (ou &eCtrl&r + rolar o mouse), &eF7&r liga e desliga os shaders.", "{@pagebreak}", "&eO Mestre Vellan:&r ele aparece &fna sua frente&r assim que você entra no mundo pela primeira vez.", "Clique nele com o botão direito para conversar e escolher sua classe. Ele também comenta cada etapa da história e dá dicas.", "&7Se você mudar de base, a missão \"Chamar o Mestre\" traz ele até você.&r"]
			tasks: [
				{
					id: "4A7E5C2F98DD01D9"
					type: "checkmark"
					title: "Li a carta do Mestre"
				}
			]
