	quests: [
		{
			id: "2D42558563013C01"
			title: "Além do Céu"
			x: 0.0d
			y: 1.0d
			subtitle: "Os mundos acima das nuvens"
			icon: "blue_skies:zeal_lighter"
			shape: "gear"
			size: 2.0d
			description: ["&6Mestre Vellan&r: \"Encontrei nos arquivos mais antigos da Ordem: os guardiões do Selo não morreram. Eles se refugiaram em dois mundos acima das nuvens.\"", "", "&o\"O &bEverbright&o, de luz e gelo eterno, e o &6Everdawn&o, onde o sol nunca termina de nascer. Mas algo aconteceu com eles: os fragmentos que caíram por lá os enlouqueceram.\"", "", "&o\"Existe um &fGuardião do Portal&o que vive em uma casa no nosso mundo e sabe abrir o caminho. Leve este &fIsqueiro Zeal&o e os tijolos que separei.\""]
			dependencies: ["6191703B0919D2E4"]
			tasks: [
				{
					id: "67686056509D0F54"
					type: "checkmark"
					title: "Partir para além do céu"
